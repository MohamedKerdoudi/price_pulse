{
  "name": "pricepulse-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts --testPathPattern='tests/unit'",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts --testPathPattern='tests/unit'",
    "test:integration": "set NODE_ENV=test&& node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts --testPathPattern='tests/integration' --forceExit",
    "test:e2e": "npx playwright test",
    "migration:run": "tsx src/config/migrate.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "@playwright/test": "^1.50.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3"
  }
}
